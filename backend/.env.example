# 🩺 CodeMedic AI Backend - Environment Variables Template
# Copy this file to a new file named '.env' in this directory and fill in your values.

# -- Server Configuration --
PORT=3001
NODE_ENV=development
JWT_SECRET=your_jwt_signing_secret_here_make_it_long_and_secure

# -- Database Configuration --
# Example local connection: postgresql://postgres:password@localhost:5432/codemedic
# Or your hosted database URL (e.g. Neon, Supabase, Render PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/codemedic

# -- AI & Embeddings Model (Hugging Face) --
# Create a free Hugging Face account and get an API token with 'read' access at https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_api_token_here

# -- Nodemailer SMTP Configuration --
# To use Gmail:
# 1. Enable 2-Step Verification on your Google Account (https://myaccount.google.com/)
# 2. Search for and create an "App Password" (https://myaccount.google.com/apppasswords)
# 3. Enter the 16-character code generated by Google as the SMTP_PASS below.
# Note: Regular Gmail passwords will NOT work for SMTP authentication!
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# Optional: Sender name / address (defaults to SMTP_USER if not set)
EMAIL_FROM="CodeMedic AI" <your_gmail_address@gmail.com>

# Set to true to print detailed SMTP exchange logs in the terminal
SMTP_DEBUG=true

# -- Google OAuth Credentials (Optional) --
# Configure this if you want to support Google Sign-In. 
# Set your redirect URI in Google Developer Console to: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# -- App URL --
# Points to where the frontend is running (used for email verification links)
APP_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
